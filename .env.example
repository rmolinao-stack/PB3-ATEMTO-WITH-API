# API keys para acceder a la API de Gemini y TMB
GEMINI_API_KEY=tu_clave_de_google_ai_studio
TMB_API_ID=tu_clave_de_app_tmb
TMB_API_KEY=tu_clave_de_key_tmb

# Acceso a la API (query ?api_key=). Copiar a .env y no subir .env al repo.
API_KEY=mi_api_key

# Máximo de peticiones por clave en 60 s
RATE_LIMIT_PER_MINUTE=30

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8501,http://localhost:3000
#CORS_ORIGINS=*

# Permite enviar cookies y credenciales en las peticiones CORS. Si CORS con * debe ponerse a false
CORS_ALLOW_CREDENTIALS=true
#CORS_ALLOW_CREDENTIALS=false

# Timeout por defecto (ajustar a vuestra red)
ASK_TIMEOUT_SECONDS=300

# URL de la base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:contraseña@url:puerto/mi_base_de_datos